import "../const/ln2.nagi"

def ln(x:f64)->f64:
    if x <= 0.0:
        return 0.0

    k = 0.0
    m = x

    while m >= 2.0:
        m = m / 2.0
        k += 1.0

    while m < 1.0:
        m *= 2.0
        k -= 1.0
    z = (m - 1.0) / (m + 1.0)
    z2 = z * z
    term = z
    s = 0.0
    n = 0.0
    for i in range(60):
        s += term / (2.0 * n + 1.0)
        term *= z2
        n+=1.0

    return k * ln2() + 2.0 * s