import "sqrt.nagi"
import "../conv/2number.nagi"

def pow2(value:f64) -> f64:
    x = value
    y:f64 = 1.0
    while x >= 1.0:
        y *= 2.0
        x -= 1.0

    while x <= -1.0:
        y *= 0.5
        x += 1.0
    return y

def pow(v:f64, i:i64) -> f64:
    x = i
    y:f64 = 1.0
    while x>0:
        y *= v
        x -= 1
    return y