def int_to_float(x: i64) -> f64:
    negative = x < 0
    if negative:
        x = -x

    result: f64 = 0.0
    place: f64 = 1.0

    for _ in range(19):
        digit = x % 10
        x = x / 10

        result += to_float_digit(digit) * place
        place *= 10.0

        if x == 0:
            if negative:
                result = -result
        
            return result

    if negative:
        result = -result

    return result

def to_float_digit(d: i64) -> f64:
    if d == 0:
        return 0.0
    if d == 1:
        return 1.0
    if d == 2:
        return 2.0
    if d == 3:
        return 3.0
    if d == 4:
        return 4.0
    if d == 5:
        return 5.0
    if d == 6:
        return 6.0
    if d == 7:
        return 7.0
    if d == 8:
        return 8.0
    return 9.0